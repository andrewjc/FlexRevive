#include <winver.h>

// Version resource, so the DLL identifies itself in Explorer's Properties dialog and in mod
// manager listings.
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,1,0,0
PRODUCTVERSION  1,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "AndyR007"
            VALUE "FileDescription",  "FlexRevive - weapon debris physics for Fallout 4"
            VALUE "FileVersion",      "1.1.0.0"
            VALUE "InternalName",     "FlexRevive"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "FlexRevive.dll"
            VALUE "ProductName",      "FlexRevive"
            VALUE "ProductVersion",   "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
